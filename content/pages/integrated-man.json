          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The land"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Elkstone Farm, Steamboat Springs"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Farm dinners and lunches through the weekend, cooked on site with local meat and fresh produce. Camp on the land at no charge in a tent or camper van, a short walk from the main house, where showers, bathrooms and a full kitchen are open around the clock. Or stay in Steamboat Springs, about five minutes away; there’s a list for men who want to share housing."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "40345 Virtus Way, Steamboat Springs, CO 80487"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_87y5zk9shg",
          "type": "button",
          "v": 1,
          "fields": {
            "label": "Visit Elkstone Farm",
            "link": {
              "type": "url",
              "url": "https://elkstonefarm.com"
            },
            "role": "secondary"
          }
        },
        {
          "id": "blk_mte8cqckd4",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Your guides"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_d6f2nhrzxy",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Licensed psychotherapist and men’s work facilitator. Known for cutting clarity and accountability."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Jeffrey James"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Ordained Zen priest, published author and martial arts lineage holder. Known for direct challenge and insight."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Keith Martin-Smith"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Acupuncturist, permaculture expert, martial artist and community leader. Known for heart, curiosity and joy."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Marco Lam"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Licensed psychotherapist. Known for a grounded, everyday-man approach and warm listening."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Eddie Konold"
              }
            ],
            "columns": "4",
            "aspect": "4:5"
          }
        },
        {
          "id": "blk_5stpdrr2gv",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Keith and Marco have sat in the same men’s group for nearly twenty years."
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
