          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The shape of the weekend"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Friday night to Sunday supper."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_s4eempm4kj",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Opening council, dinner at the farm, and a fire circle."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Friday evening"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Morning sit and embodiment, then circles and teaching through the day, an afternoon break to wander and practice, an evening closing circle and a warrior’s rest meditation."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Saturday"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Morning sit and embodiment, more circle work through the afternoon, and a closing session on bringing it home."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Sunday"
              }
            ],
            "columns": "3",
            "aspect": "4:5"
          }
        }
      ]
    },
    {
