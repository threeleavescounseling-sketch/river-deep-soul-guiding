          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "What we practice"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 2
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Embodied, relational, and honest."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_18hq861f42",
          "type": "columns",
          "v": 1,
          "fields": {
            "items": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Direct coaching in the center of the circle with all four leaders."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Hot seat in the circle"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Physical practices to get back into the body, where the heart and the fire live."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Embodiment"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Meeting the buried and denied parts that run the show from underneath."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Shadow work"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Practicing with other men, staying relational when triggered, leading with curiosity."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Partner & group work"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Meditation and mindful, fierce presence with yourself and the other men."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Sitting practice"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Taking responsibility for your life and relationships, and bringing the weekend home."
                        }
                      ]
                    }
                  ]
                },
                "heading": "Direct accountability"
              }
            ],
            "columns": "3",
            "aspect": "4:5"
          }
        }
      ]
    },
    {
