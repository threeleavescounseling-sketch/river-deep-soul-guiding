  "slug": "integrated-man",
  "seo": {
    "title": "The Integrated Man — River Deep Soul Guiding",
    "description": "The Integrated Man: a men's weekend at Elkstone Farm, Steamboat Springs, with Jeffrey James, Keith Martin-Smith, Marco Lam and Eddie Konold."
  },
