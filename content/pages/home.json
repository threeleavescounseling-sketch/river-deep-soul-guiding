          "v": 1,
          "fields": {
            "items": [
              {
                "heading": "Men’s Group Programs",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Nine-week group sessions to explore a different way of being in ourselves, our relationships, and the larger world."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Individual Soul Guiding",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Deeply relational and collaborative sessions with a clear focus on personal work, reflection, and avenues of change and growth."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "heading": "Retreats for Men",
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Intensely immersive journeys to challenge you physically, psychologically, and spiritually."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "columns": "3",
            "aspect": "4:5"
          }
        }
      ]
    },
